# Copy to .env (never committed) and fill in. Reference: docs/CONFIGURATION.md.

# Public domain name of the server (Caddy obtains the HTTPS certificate).
PARFUMO_MCP_DOMAIN=mcp.example.com

# AES-256-GCM master key, 32 bytes in base64. Generate it with:
#   docker compose run --rm --no-deps server keygen
# Losing it makes the stored Parfumo credentials and cookies unreadable.
PARFUMO_MCP_MASTER_KEY=

# Optional (defaults shown).
# PARFUMO_BASE_URL=https://www.parfumo.com
# PARFUMO_MCP_USER_MIN_INTERVAL_MS=1000
# PARFUMO_MCP_GLOBAL_RPS=2
# PARFUMO_MCP_ACCESS_TOKEN_TTL_SECS=3600
# PARFUMO_MCP_REFRESH_TOKEN_TTL_SECS=2592000

# Writes that other members can see (wear, rating, classification, review, statement,
# message, forum…). By default they stay in dry run: the tool shows the requests and sends
# nothing.
# PARFUMO_MCP_PUBLIC_WRITES=false

# Daily caps on public writes, per tool and per user (tool=number, comma-separated;
# 0 forbids). Tools not listed keep their default: send_message 20, forum_post 10,
# write_review 10, write_statement 10, wall 10, blog 5, souk_manage_offer 10,
# manage_follow 30, update_profile 20, log_wear 20, rate_perfume 100, classify_perfume 100.
# PARFUMO_MCP_PUBLIC_WRITE_CAPS=parfumo_send_message=20,parfumo_forum_post=10

# Parfumo members the server accepts to write to (message, wall, follow).
# Empty: no restriction.
# PARFUMO_MCP_WRITE_RECIPIENTS=

# Canary: once a day, a read-only pass over every kind of page on the real site (about one
# minute, one request per second). UTC hour from 0 to 23, or off.
# PARFUMO_MCP_CANARY_HOUR=4
# Server user whose linked Parfumo account (a test account) is read too.
# Empty: public pages only.
# PARFUMO_MCP_CANARY_USER=
# URL that receives a JSON alert when the canary reports a change (Slack, Discord…).
# PARFUMO_MCP_CANARY_WEBHOOK=

# Alternative for the master key: path of a file (Docker secret) instead of the value.
# PARFUMO_MCP_MASTER_KEY_FILE=/run/secrets/parfumo_master_key
